<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sin QUERY_ALL_PACKAGES, ni internet, ni nada: el bloque <queries> basta para ver todas las apps con ícono en el menú.
         BIND_APPWIDGET (fase 6B-1): Android solo lo concede a launchers del sistema; en un launcher normal
         se pide al usuario con el diálogo ACTION_APPWIDGET_BIND la primera vez que coloca un widget. -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density">

            <!-- Para poder abrirlo a mano y probarlo sin ser el predeterminado -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lo que lo hace elegible como pantalla de inicio -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Pantallas provisionales ("Próximamente") -->
        <activity
            android:name=".ComingSoonActivity"
            android:exported="false"
            android:theme="@style/ScreenTheme" />

        <!-- Configuración de pantalla principal y selector de fuentes -->
        <activity
            android:name=".HomeSettingsActivity"
            android:exported="false"
            android:theme="@style/ScreenTheme" />
        <activity
            android:name=".FontsActivity"
            android:exported="false"
            android:theme="@style/ScreenTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- Fondos y temas -->
        <activity
            android:name=".BackgroundsActivity"
            android:exported="false"
            android:theme="@style/ScreenTheme" />
        <activity
            android:name=".PlaylistActivity"
            android:exported="false"
            android:theme="@style/ScreenTheme" />

        <!-- Panel de widgets (Fase 6A) -->
        <activity
            android:name=".WidgetsActivity"
            android:exported="false"
            android:theme="@style/ScreenTheme"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
